{
  "name": "zasatsu-bakuto",
  "version": "0.1.0",
  "description": "坐殺博徒 Zasatsu Bakuto: Kinji Hakari's Domain Expansion as a pachinko overlay that shows what your AI coding agent is doing. Tool calls spin the reels, tests are the riichi, green tests hit the jackpot.",
  "license": "MIT",
  "bin": {
    "ryoiki": "bin/ryoiki.js"
  },
  "main": "src/electron-main.js",
  "files": [
    "bin",
    "src",
    "public"
  ],
  "scripts": {
    "start": "node bin/ryoiki.js tenkai",
    "serve": "node bin/ryoiki.js serve",
    "demo": "node bin/ryoiki.js demo",
    "test": "node --test \"test/*.test.js\"",
    "icon": "electron scripts/render-icon.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron": "^33.0.0"
  },
  "keywords": [
    "claude-code",
    "ai-agent",
    "hooks",
    "overlay",
    "pachinko",
    "obs"
  ]
}
